msgstr "This site is not accepting new accounts. Public knowledge and problems remain available."

msgid "创建学习账号"
msgstr "Create a learning account"

msgid "注册"
msgstr "Register"

msgid "只需要用户名与密码。代码和学习记录默认仅你可见。"
msgstr "Only a username and password are required. Your code and learning records are private by default."

msgid "用户名或恢复码无效。"
msgstr "Invalid username or recovery code."

