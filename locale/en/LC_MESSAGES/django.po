msgid "内容类型"
msgstr "Content type"

msgid "标题"
msgstr "Title"

msgid "关联题目版本（题解必选）"
msgstr "Linked problem version (required for solutions)"

msgid "正文（纯文本）"
msgstr "Body (plain text)"

msgid "题解必须选择明确的题目版本。"
msgstr "Solutions must select a specific problem version."

msgid "评论（纯文本）"
msgstr "Comment (plain text)"

msgid "审核通过"
msgstr "Approve"

msgid "不通过"
msgstr "Reject"

msgid "隐藏已公开内容"
msgstr "Hide published content"

msgid "给作者的处理说明"
msgstr "Response to the author"

msgid "说明（仅本人及审核者可见）"
msgstr "Explanation (visible only to you and moderators)"

msgid "已处理"
msgstr "Resolved"

msgid "未采纳"
msgstr "Dismissed"

msgid "给举报人的处理说明"
msgstr "Response to the reporter"

msgid "接受申诉，重新送审"
msgstr "Accept appeal and resubmit for review"

msgid "维持原决定"
msgstr "Original decision upheld"

msgid "给申诉人的处理说明"
msgstr "Response to the appellant"

msgid "私有草稿"
msgstr "Private draft"

msgid "等待审核"
msgstr "Awaiting review"

msgid "已公开"
msgstr "Published"

msgid "审核未通过"
msgstr "Rejected"

msgid "已隐藏"
msgstr "Hidden"

msgid "已撤回"
msgstr "Withdrawn"

msgid "讨论"
msgstr "Discussions"

msgid "提问"
msgstr "Questions"

msgid "题解"
msgstr "Solution"

msgid "待处理"
msgstr "Open"

msgid "已重新送审"
msgstr "Resubmitted for review"

msgid "内容已修订或撤回"
msgstr "Content revised or withdrawn"

msgid "内容已改变，请刷新页面后重试。"
msgstr "The content changed. Refresh the page and try again."

msgid "关联题目已经下线，不能提交或公开这篇内容。"
msgstr ""
"The linked problem was withdrawn. This content cannot be submitted for "
"review or published."

msgid "正文或说明为空，或超过长度限制。"
msgstr "The text or explanation is empty or exceeds the length limit."

msgid "这篇内容已送审或公开。"
msgstr "This content is already pending review or published."

msgid "讨论当前未公开，评论不能送审。"
msgstr ""
"The discussion is not public; its comments cannot be submitted for review."

msgid "不能审核自己的内容。"
msgstr "You cannot moderate your own content."

msgid "请先处理父讨论；未公开讨论的评论不能公开。"
msgstr ""
"Handle the parent discussion first; comments on unpublished discussions "
"cannot be published."

msgid "内容状态已经改变，此审核操作不适用。"
msgstr "The content status changed; this moderation action no longer applies."

msgid "你已经提交过这个内容的举报，请等待处理。"
msgstr "You have already reported this content. Please wait for a response."

msgid "只有未通过审核或被隐藏的内容可以申诉。"
msgstr "Only rejected or hidden content can be appealed."

msgid "这个版本已经提交过申诉；处理结果可在我的申诉中查看。"
msgstr ""
"This revision has already been appealed. View the response in My appeals."

msgid "不能处理自己发起或涉及自己内容的举报。"
msgstr ""
"You cannot handle a report you filed or one concerning your own content."

msgid "这条举报已经处理。"
msgstr "This report has already been handled."

msgid "无效的举报决定。"
msgstr "Invalid report decision."

msgid "不能处理自己的申诉。"
msgstr "You cannot handle your own appeal."

msgid "这条申诉已经处理。"
msgstr "This appeal has already been handled."

msgid "被申诉内容已经改变，请刷新页面。"
msgstr "The appealed content changed. Please refresh the page."

msgid "申诉已接受，等待重新审核。"
msgstr "Appeal accepted; awaiting another review."

msgid "无效的申诉决定。"
msgstr "Invalid appeal decision."

msgid "操作过于频繁，请稍后重试。"
msgstr "Too many requests. Please try again later."

msgid "内容格式或长度不符合要求。"
msgstr "The content format or length is invalid."

msgid "内容已保存。私有草稿需主动送审；已送审内容的编辑会重新等待审核。"
msgstr ""
"Content saved. Private drafts must be submitted for review explicitly. "
"Editing submitted content requires another review."

msgid "编辑内容"
msgstr "Edit content"

msgid "写讨论、提问或题解"
msgstr "Write a discussion, question or solution"

msgid "评论已保存，需主动送审后才可能公开。"
msgstr "Comment saved. Submit it for review before it can become public."

msgid "编辑评论"
msgstr "Edit comment"

msgid "请刷新页面后重试。"
msgstr "Refresh the page and try again."

msgid "已提交审核，尚未公开。"
msgstr "Submitted for review; not public yet."

msgid "已撤回，不再公开。"
msgstr "Withdrawn; no longer public."

msgid "已删除正文及关联评论和私有处理记录。"
msgstr "Text, related comments and private case records deleted."

msgid "操作完成。"
msgstr "Done."

msgid "请填写有效的审核决定和处理说明。"
msgstr "Provide a valid moderation decision and explanation."

msgid "审核决定已保存。"
msgstr "Moderation decision saved."

msgid "私有举报"
msgstr "Private report"

msgid "私有申诉"
msgstr "Private appeal"

msgid "请填写有效的处理决定和说明。"
msgstr "Provide a valid decision and explanation."

msgid "处理结果已保存，仅本人及审核者可以查看。"
msgstr "Response saved. Only you and moderators can view it."

msgid "用户名"
msgstr "Username"

msgid "恢复码"
msgstr "Recovery code"

msgid "新密码"
msgstr "New password"

msgid "源代码"
msgstr "Source code"

msgid "公开样例"
msgstr "Public examples"

msgid "正式提交"
msgstr "Official submission"

msgid "源代码必须是有效的 UTF-8 文本。"
msgstr "Source code must be valid UTF-8 text."

msgid "显示名称（仅自己可见）"
msgstr "Display name (visible only to you)"

msgid "操作过于频繁，请 15 分钟后重试。"
msgstr "Too many requests. Try again in 15 minutes."

msgid "排队中"
msgstr "Queued"

msgid "正在评测"
msgstr "Judging"

msgid "评测结束"
msgstr "Finished"

msgid "评测暂不可用。你仍可阅读题目和保存草稿。"
msgstr ""
"Judging is temporarily unavailable. You can still read problems and save "
"drafts."

msgid "题目已更新或下线，请刷新后重新提交。"
msgstr "The problem changed or was withdrawn. Refresh before submitting again."

msgid "你已有待处理任务，请等待结果后继续。"
msgstr ""
"You already have a pending task. Wait for its result before continuing."

msgid "评测队列已满，请稍后重试。"
msgstr "The judging queue is full. Please try again later."

msgid "该题的资源预约策略无效，暂不能评测。"
msgstr "This task has an invalid resource reservation policy and cannot be evaluated."

msgid "今日 CPU 练习预约额度不足，请在下个 UTC 日重试。"
msgstr "Insufficient CPU practice allowance for today. Try again on the next UTC day."

msgid "题目已更新，请刷新页面。旧版本草稿仍保留。"
msgstr "The problem changed. Refresh the page; your old draft is retained."

msgid "代码不能超过 20000 字符。"
msgstr "Code cannot exceed 20000 characters."

msgid "保存过于频繁，请稍后重试。"
msgstr "Too many save requests. Please try again later."

msgid "草稿已私密保存。"
msgstr "Draft saved privately."

msgid "请提供不超过 20000 字符的源代码及有效的提交方式。"
msgstr ""
"Provide source code of at most 20000 characters and a valid submission "
"action."

msgid "题目版本已更新，请刷新后重试。"
msgstr "The problem version changed. Refresh and try again."

msgid "提交过于频繁，请稍后再试。"
msgstr "Too many submissions. Please try again later."

msgid "注册暂未开放"
msgstr "Registration is closed"

msgid "本站暂不接受新账号。公开知识和题目仍可浏览。"
msgstr ""
"This site is not accepting new accounts. Public knowledge and problems "
"remain available."

msgid "创建学习账号"
msgstr "Create a learning account"

msgid "注册"
msgstr "Register"

msgid "只需要用户名与密码。代码和学习记录默认仅你可见。"
msgstr ""
"Only a username and password are required. Your code and learning records "
"are private by default."

msgid "用户名或恢复码无效。"
msgstr "Invalid username or recovery code."

msgid "恢复账号"
msgstr "Recover account"

msgid "重置密码"
msgstr "Reset password"

msgid "使用注册时保存的恢复码。成功后旧码作废，原登录会话失效。"
msgstr ""
"Use the recovery code saved when you registered. A successful reset "
"invalidates the old code and previous login sessions."

msgid "个人资料已保存。"
msgstr "Profile saved."

msgid "密码不正确。"
msgstr "Incorrect password."

msgid "请输入当前密码，并输入 DELETE 确认删除。"
msgstr "Enter your current password and type DELETE to confirm."

msgid "账号已删除"
msgstr "Account deleted"

msgid ""
"账号、草稿、提交、学习记录及你发布的社区内容已从当前数据库删除。审核事件只保"
"留不含正文的操作记录，操作者关联已清除。备份按站点保留周期清除。"
msgstr ""
"Your account, drafts, submissions, learning records and community content "
"were deleted from the current database. Moderation events retain action "
"records without text, and the actor link was cleared. Backups expire "
"according to the site's retention policy."

msgid "复习"
msgstr "Review"

#, python-format
msgid "当前版本最近一次正式结果为「%(verdict)s」，可复查边界与约束。"
msgstr ""
"Your latest official result on this version was “%(verdict)s”. Review the "
"boundaries and constraints."

msgid "前置练习"
msgstr "Prerequisite practice"

#, python-format
msgid ""
"「%(problem)s」涉及「%(concept)s」；其前置「%(target)s」尚无当前题正式通过记"
"录。可先练习，也可以跳过。"
msgstr ""
"“%(problem)s” involves “%(concept)s”. Its prerequisite “%(target)s” has no "
"accepted submission on a current problem version. Try it first, or skip this "
"suggestion."

#, python-format
msgid "当前版本已有 %(attempts)s 次正式结果，尚无通过记录。"
msgstr ""
"This version has %(attempts)s official results and no accepted answer yet."

msgid "当前版本尚无正式评测记录，可以从公开样例开始。"
msgstr ""
"No official result on this version yet. Start with the public examples."

msgid "继续练习"
msgstr "Continue practising"

msgid "间隔复习"
msgstr "Spaced review"

#, python-format
msgid ""
"当前版本已有通过记录，最近正式结果距今超过 %(days)s 天；可尝试独立重做。"
msgstr ""
"You have passed this version, but your latest official result is more than "
"%(days)s days old. Try solving it independently again."

msgid "中文原文"
msgstr "Chinese original"

msgid "关联题目版本"
msgstr "Linked problem version"

msgid "关联知识节点"
msgstr "Linked knowledge node"

msgid "笔记正文"
msgstr "Note body"

msgid "最多 120 个字符。"
msgstr "At most 120 characters."

msgid "最多 10,000 个字符，按纯文本保存，仅你可见。"
msgstr ""
"At most 10,000 characters, stored as plain text and visible only to you."

msgid "一份笔记只能关联一个题目版本或知识节点。"
msgstr ""
"A note can link to one problem version or one knowledge node, not both."

msgid "保存操作过于频繁，请一分钟后重试。"
msgstr "Too many save requests. Try again in a minute."

msgid "题目已加入私有收藏。"
msgstr "Problem added to private bookmarks."

msgid "已取消收藏。"
msgstr "Bookmark removed."

msgid "请选择收藏或取消收藏。"
msgstr "Choose whether to add or remove a bookmark."

msgid "笔记已删除。"
msgstr "Note deleted."

msgid "已记录你自述的阅读完成状态。"
msgstr "Your self-reported reading completion was recorded."

msgid "已取消阅读标记。"
msgstr "Reading mark cleared."

msgid "请选择阅读完成或取消标记。"
msgstr "Choose whether to mark as read or clear the mark."

msgid "通过"
msgstr "Accepted"

msgid "答案有误"
msgstr "Wrong answer"

msgid "语法错误"
msgstr "Syntax error"

msgid "运行错误"
msgstr "Runtime error"

msgid "超过时间限制"
msgstr "Time limit exceeded"

msgid "超过内存限制"
msgstr "Memory limit exceeded"

msgid "输出过多"
msgstr "Output limit exceeded"

msgid "评测服务故障，请稍后重试"
msgstr "Judge service failure. Please try again later."

msgid "入门"
msgstr "Introductory"

msgid "基础"
msgstr "Foundational"

msgid "进阶"
msgstr "Advanced"

msgid "当前评测环境不支持这道题的运行方式；仍可阅读、编辑和保存草稿。"
msgstr ""
"The current evaluation environment does not support this problem’s execution "
"mode. You can still read the problem, edit code, and save drafts."

msgid ""
"JavaScript / QuickJS 2026-06-04；只支持同步 JSON 函数，不提供 Node.js、DOM、"
"网络或模块导入。每用例 128 MiB 线性内存、15 秒总等待、32 KiB 输出；运算量超限"
"也会终止。"
msgstr ""
"JavaScript / QuickJS 2026-06-04; synchronous JSON functions only. Node.js, "
"the DOM, networking, and module imports are unavailable. Each case allows "
"128 MiB of linear memory, 15 seconds of total waiting time, and 32 KiB of "
"output. Execution also stops when the operation limit is exceeded."

msgid ""
"Python 3.14.9 / WASI 完整程序；从标准输入读取文本，标准输出须恰为一个 JSON "
"值。编译检查与运行分别限 15 秒、128 MiB 线性内存；输出上限 32 KiB。没有网络、"
"文件写入、进程、线程或第三方扩展。"
msgstr ""
"Python 3.14.9 / WASI complete program; read text from standard input and "
"write exactly one JSON value to standard output. Compilation checks and "
"execution each allow 15 seconds and 128 MiB of linear memory; output is "
"limited to 32 KiB. Networking, file writes, processes, threads, and third-"
"party extensions are unavailable."

msgid ""
"Python 3.14.9 / WASI 基础标准库；不支持网络、文件写入、进程、线程和第三方扩"
"展。每用例 128 MiB 线性内存、15 秒总等待、32 KiB 输出；运算量超限也会终止。"
msgstr ""
"Python 3.14.9 / WASI basic standard library; no network, file writes, "
"processes, threads or third-party extensions. Each case has 128 MiB linear "
"memory, 15 seconds total wait and 32 KiB output; exceeding the instruction "
"budget also terminates execution."

msgid ""
"Python 3.11.15 标准库；每用例 128 MiB 内存、2 秒 CPU、8 秒总等待、32 KiB 输"
"出。"
msgstr ""
"Python 3.11.15 standard library; each case has 128 MiB memory, 2 seconds "
"CPU, 8 seconds total wait and 32 KiB output."

msgid "等待评测超时，请稍后重新提交。"
msgstr "The wait for judging timed out. Please submit again later."

msgid "用途名称"
msgstr "Purpose label"

msgid "有效天数"
msgstr "Validity in days"

msgid "提交本人的练习"
msgstr "Submit my exercises"

msgid "读取本人的结果"
msgstr "Read my results"

msgid "当前密码"
msgstr "Current password"

msgid "请至少选择一个权限。"
msgstr "Select at least one permission."

msgid "无法创建令牌，请检查有效期、权限和十个有效令牌的上限。"
msgstr ""
"Cannot create a token. Check its validity, permissions and the limit of ten "
"active tokens."

msgid "公开名称"
msgstr "Public name"

msgid "公开简介"
msgstr "Public bio"

msgid "开启公开主页"
msgstr "Enable public profile"

msgid "我确认公开用户名、公开名称和简介；仅主动分享的评测结果进入作品和榜单。"
msgstr ""
"I agree to publish my username, public name and bio. Only results I "
"explicitly share will appear in my portfolio and leaderboards."

msgid "开启公开主页前请填写独立的公开名称。"
msgstr "Enter a separate public name before enabling your public profile."

msgid "请明确确认上述公开范围。"
msgstr "Explicitly confirm the public information listed above."

msgid "我确认公开用户名及这次正式结果，并参与同题目版本、同策略的测试进度榜。"
msgstr ""
"I agree to publish my username and this official result, and join the test-"
"progress leaderboard for this exact problem version and policy."

msgid "这条记录缺少可核对的正式评测结果，暂不能公开。"
msgstr ""
"This record lacks a verifiable official result and cannot be published."

msgid "公开状态已经改变，请刷新页面后重试。"
msgstr "The public status changed. Refresh the page and try again."

msgid "公开需要独立名称和明确确认。"
msgstr "Publication requires a separate public name and explicit confirmation."

msgid "请先明确开启公开主页。"
msgstr "Explicitly enable your public profile first."

msgid "公开结果需要明确确认。"
msgstr "Sharing a result requires explicit confirmation."

msgid "题目已经下线，不能公开这条结果。"
msgstr "The problem was withdrawn. This result cannot be published."

msgid "操作过于频繁，请一分钟后重试。"
msgstr "Too many requests. Try again in a minute."

msgid "填写内容或公开确认不符合要求。"
msgstr "The entered content or publication confirmation is invalid."

msgid "公开主页设置已保存。评测结果需要逐条主动分享。"
msgstr "Public profile settings saved. Each result must be shared separately."

msgid "主页已关闭，作品和榜单条目已撤回。独立公开的社区正文保持原状态。"
msgstr ""
"Profile closed; portfolio and leaderboard entries withdrawn. Independently "
"published community posts keep their current status."

msgid "题目已下线，不能公开这条结果。"
msgstr "The problem was withdrawn. This result cannot be published."

msgid "这条评测结果已从公开作品和榜单撤回。"
msgstr "This result was withdrawn from the public portfolio and leaderboard."

msgid "这次操作未获授权。"
msgstr "This action was not authorized."

msgid "请刷新页面并重新登录后重试。"
msgstr "Refresh the page and log in again before retrying."

msgid "前往登录 →"
msgstr "Go to login →"

msgid "没有找到这个页面。"
msgstr "Page not found."

msgid "内容可能已下线，或你没有访问权限。"
msgstr "This content may have been withdrawn, or you may not have access."

msgid "返回题库 →"
msgstr "Return to the problem library →"

msgid "服务暂不可用"
msgstr "Service temporarily unavailable"

msgid "请稍后重试。如果你正在编辑，请先保留代码。"
msgstr ""
"Please try again later. If you are editing, save a copy of your code first."

msgid "返回首页"
msgstr "Return home"

msgid "账号与隐私 · PraxiMesh"
msgstr "Account and privacy · PraxiMesh"

msgid "ACCOUNT / 账号与隐私"
msgstr "ACCOUNT / Privacy and settings"

msgid "你的代码，属于你。"
msgstr "Your code belongs to you."

msgid ""
"源代码、草稿、收藏、笔记与学习记录仅自己可见。社区内容只有主动送审并通过后，"
"正文和用户名才会公开。公开主页与评测结果须另行主动分享。基本资料中的显示名称"
"仍是私密资料。"
msgstr ""
"Your code, drafts, bookmarks, notes and learning records are private. "
"Community text and your username become public only after you request review "
"and receive approval. Public profiles and results require separate, explicit "
"sharing. Your profile display name remains private."

msgid "基本资料"
msgstr "Profile"

msgid "保存"
msgstr "Save"

msgid "管理本地工具访问令牌 →"
msgstr "Manage local tool access tokens →"

msgid "管理公开主页与作品 →"
msgstr "Manage public profile and portfolio →"

msgid "导出我的数据"
msgstr "Export my data"

msgid ""
"包含账号资料、源代码、草稿、提交结果、路径、收藏、笔记、阅读记录、本人社区内"
"容、公开主页设置和分享选择；包含访问令牌用途和到期时间，不包含令牌密钥、密"
"码、恢复码或他人的私密信息。"
msgstr ""
"Includes your account details, code, drafts, results, paths, bookmarks, "
"notes, reading records, community content, public profile settings and "
"sharing choices, plus token purposes and expiry times. Excludes token "
"secrets, passwords, recovery codes and other people's private information."

msgid "下载 JSON"
msgstr "Download JSON"

msgid "换发恢复码"
msgstr "Replace recovery code"

msgid "换发后原恢复码失效。"
msgstr "Replacing the code invalidates the previous one."

msgid "生成新恢复码"
msgstr "Generate new recovery code"

msgid "删除账号"
msgstr "Delete account"

msgid ""
"此操作删除账号、草稿、提交、学习记录、访问令牌、公开主页、分享成绩和你发布的"
"社区内容。不能撤销。审核事件仅保留不含正文的操作记录，并清除操作者关联。备份"
"按站点保留周期清除。"
msgstr ""
"This permanently deletes your account, drafts, submissions, learning "
"records, access tokens, public profile, shared results and community "
"content. Moderation events retain action records without text, and the actor "
"link is cleared. Backups expire according to the site's retention policy."

msgid "输入 DELETE 确认"
msgstr "Type DELETE to confirm"

msgid "永久删除当前账号"
msgstr "Permanently delete this account"

msgid "不收集邮箱。请在下一步保存你的账号恢复码。"
msgstr ""
"We do not collect an email address. Save your account recovery code on the "
"next page."

msgid "已有账号？登录 →"
msgstr "Already have an account? Log in →"

msgid "PraxiMesh · 用代码理解知识"
msgstr "PraxiMesh · Understand through code"

msgid "从结构化知识到亲手编程，沿路径学习，也可以直接开始练习。"
msgstr ""
"Explore structured knowledge and put it into practice. Follow a path or "
"start with an exercise."

msgid "跳到主要内容"
