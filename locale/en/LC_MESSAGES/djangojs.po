msgid "正在本地检查…"
msgstr "Checking locally…"

msgid "正在本地格式化…"
msgstr "Formatting locally…"

msgid "本地检查工具暂不可用；代码已保留，可以继续编辑、保存和提交。"
msgstr "Local checks are unavailable. Your code is preserved; you can still edit, save and submit."

msgid "格式化期间代码已修改，请重新格式化。"
msgstr "Your code changed during formatting. Format again to use the latest edits."

msgid "请先修复语法错误，再格式化。"
msgstr "Fix syntax errors before formatting."

msgid "已格式化，可撤销。"
msgstr "Formatted. You can undo this change."

msgid "代码格式无需调整。"
msgstr "Code is already formatted."

msgid "代码不能超过 20000 字符。"
msgstr "Code must not exceed 20,000 characters."

#, javascript-format
msgid "第 %s 行，第 %s 列"
msgstr "Line %s, column %s"

msgid "源代码"
msgstr "Source code"

msgid "查找"
msgstr "Find"

msgid "替换"
msgstr "Replace"

msgid "下一个"
msgstr "Next"

msgid "上一个"
msgstr "Previous"

msgid "全部"
msgstr "All"

msgid "区分大小写"
msgstr "Match case"

msgid "正则表达式"
msgstr "Regular expression"

msgid "全词匹配"
msgstr "Whole word"

msgid "全部替换"
msgstr "Replace all"

msgid "关闭"
msgstr "Close"

msgid "没有检查提示"
msgstr "No diagnostics"

msgid "检查提示"
msgstr "Diagnostics"

msgid "没有补全候选"
msgstr "No completions"

msgid "代码补全"
msgstr "Code completion"

msgid "折叠代码"
msgstr "Fold code"

msgid "展开代码"
msgstr "Unfold code"

msgid "跳转到行"
msgstr "Go to line"

msgid "跳转"
msgstr "Go"

msgid "已删除选中内容"
msgstr "Selection deleted"

#, javascript-format
msgid "发现 %s 条检查提示；不影响保存或提交。"
msgstr "Found %s diagnostics. You can still save or submit."

msgid "本地检查未发现问题；运行结果仍以评测为准。"
msgstr "No issues found locally. Evaluation still determines the result."

msgid "尚未保存"
msgstr "Unsaved changes"

msgid "正在保存…"
msgstr "Saving…"

msgid "正在提交…"
msgstr "Submitting…"

msgid "登录可能已过期。请先保留代码，再刷新并登录。"
msgstr "Your session may have expired. Save a copy of your code, then refresh and log in."

msgid "操作失败，请稍后重试。"
msgstr "The operation failed. Please try again later."

msgid "上一份草稿已保存；当前还有修改。"
msgstr "The previous draft was saved; you have further changes."

msgid "草稿已私密保存"
msgstr "Draft saved privately"

msgid "已提交所选代码；编辑区的新修改尚未保存。请到我的学习查看结果。"
msgstr "The selected code was submitted. Your newer edits are unsaved. View the result in My learning."

msgid "连接中断，请稍后重试。"
msgstr "Connection interrupted. Please try again later."

msgid "暂时无法读取状态，请刷新页面或重新登录。"
msgstr "Cannot read the status right now. Refresh or log in again."

msgid "连接暂时中断，正在重试。你也可以稍后在提交历史查看结果。"
msgstr "Connection interrupted; retrying. You can also view the result later in submission history."
