# Production template. Never commit populated values.
PRAXIMESH_MODE=production
APP_SECRET_KEY=REPLACE_WITH_AT_LEAST_50_RANDOM_CHARACTERS
APP_ALLOWED_HOSTS=learn.example.org
CSRF_TRUSTED_ORIGINS=https://learn.example.org
TRUST_TLS_PROXY=1
TRUSTED_PROXY_IPS=127.0.0.1,::1
DATABASE_URL=postgresql://praximesh:REPLACE@db.example.internal/praximesh
DB_SSLMODE=verify-full
REGISTRATION_OPEN=0
JUDGE_ENABLED=0
JUDGE_BACKEND=wasi
JUDGE_WASI_SHA256=
# Only the worker needs this artifact path; Web needs its matching SHA-256.
JUDGE_WASI_BUNDLE=
JUDGE_IMAGE=
JUDGE_RECEIPT=/srv/praximesh/var/sandbox-receipt.json
