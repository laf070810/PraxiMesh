{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://praximesh.invalid/schema/content-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "nodes",
    "problems"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "nodes": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/node"
      }
    },
    "problems": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "#/$defs/problem"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,79}$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20000
    },
    "ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "title",
        "summary",
        "body",
        "domains",
        "topics",
        "concepts",
        "outcomes",
        "aliases",
        "relations",
        "steps",
        "license",
        "attribution"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "kind": {
          "enum": [
            "domain",
            "topic",
            "concept",
            "tutorial",
            "path"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "summary": {
          "$ref": "#/$defs/text"
        },
        "body": {
          "type": "string",
          "maxLength": 40000
        },
        "domains": {
          "$ref": "#/$defs/ids"
        },
        "topics": {
          "$ref": "#/$defs/ids"
        },
        "concepts": {
          "$ref": "#/$defs/ids"
        },
        "aliases": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "outcomes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "relations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "target"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "required",
                  "recommended",
                  "related"
                ]
              },
              "target": {
                "$ref": "#/$defs/id"
              }
            }
          }
        },
        "steps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind",
              "target"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "tutorial",
                  "problem"
                ]
              },
              "target": {
                "$ref": "#/$defs/id"
              }
            }
          }
        },
        "license": {
          "$ref": "#/$defs/text"
        },
        "attribution": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "args",
        "expected",
        "public"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "args": {
          "type": "array",
          "maxItems": 8
        },
        "expected": {},
        "public": {
          "type": "boolean"
        }
      }
    },
    "problem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "title",
        "summary",
        "statement",
        "constraints",
        "outcomes",
        "concepts",
        "difficulty",
        "language",
        "evaluator",
        "starter",
        "reference",
        "hints",
        "tests",
        "comparison",
        "changelog",
        "license",
        "attribution",
        "tags"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "summary": {
          "$ref": "#/$defs/text"
        },
        "statement": {
          "$ref": "#/$defs/text"
        },
        "constraints": {
          "$ref": "#/$defs/text"
        },
        "outcomes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "concepts": {
          "allOf": [
            {
              "$ref": "#/$defs/ids"
            }
          ],
          "minItems": 1
        },
        "difficulty": {
          "enum": [
            "入门",
            "基础",
            "进阶"
          ]
        },
        "language": {
          "enum": [
            "python",
            "javascript"
          ]
        },
        "evaluator": {
          "enum": [
            "python-function-v1",
            "javascript-function-v1",
            "python-stdio-v1",
            "python-ml-linear-v1",
            "python-weighted-fit-v1",
            "python-agent-tools-v1",
            "python-object-api-v1"
          ]
        },
        "function": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,60}$"
        },
        "starter": {
          "$ref": "#/$defs/text"
        },
        "reference": {
          "$ref": "#/$defs/text"
        },
        "hints": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "tests": {
          "type": "array",
          "minItems": 2,
          "maxItems": 20,
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/case"
              },
              {
                "$ref": "#/$defs/stdio_case"
              },
              {
                "$ref": "#/$defs/ml_case"
              },
              {
                "$ref": "#/$defs/scientific_case"
              },
              {
                "$ref": "#/$defs/agent_case"
              },
              {
                "$ref": "#/$defs/api_case"
              }
            ]
          }
        },
        "comparison": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "absolute",
            "relative"
          ],
          "properties": {
            "kind": {
              "enum": [
                "exact",
                "numeric"
              ]
            },
            "absolute": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.001
            },
            "relative": {
              "type": "number",
              "minimum": 0,
              "maximum": 0.001
            }
          }
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 60
          }
        },
        "changelog": {
          "$ref": "#/$defs/text"
        },
        "license": {
          "$ref": "#/$defs/text"
        },
        "attribution": {
          "$ref": "#/$defs/text"
        },
        "output_format": {
          "const": "json"
        },
        "model_kind": {
          "const": "linear-regression-v1"
        },
        "uncertainty_model": {
          "const": "known-independent-sigma-v1"
        },
        "assessment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "resource_profile"
          ],
          "properties": {
            "kind": {
              "const": "approved-ledger-v1"
            },
            "resource_profile": {
              "const": "wasi-agent-v1"
            }
          }
        },
        "interface": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "class_name",
            "constructor_arity",
            "methods"
          ],
          "properties": {
            "class_name": {
              "type": "string",
              "pattern": "^[A-Z][A-Za-z0-9_]{0,59}$"
            },
            "constructor_arity": {
              "type": "integer",
              "minimum": 0,
              "maximum": 8
            },
            "methods": {
              "type": "object",
              "minProperties": 1,
              "maxProperties": 16,
              "propertyNames": {
                "pattern": "^[a-z][a-z0-9_]{0,39}$"
              },
              "additionalProperties": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "arity",
                  "raises"
                ],
                "properties": {
                  "arity": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 8
                  },
                  "raises": {
                    "type": "array",
                    "uniqueItems": true,
                    "items": {
                      "enum": [
                        "IndexError",
                        "KeyError",
                        "ValueError",
                        "TypeError",
                        "OverflowError",
                        "ZeroDivisionError"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "evaluator": {
                "const": "python-function-v1"
              }
            }
          },
          "then": {
            "required": [
              "function"
            ],
            "properties": {
              "language": {
                "const": "python"
              },
              "tests": {
                "minItems": 4,
                "maxItems": 20,
                "items": {
                  "$ref": "#/$defs/case"
                }
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "model_kind"
                  ]
                },
                {
                  "required": [
                    "output_format"
                  ]
                },
                {
                  "required": [
                    "uncertainty_model"
                  ]
                },
                {
                  "required": [
                    "assessment"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "evaluator": {
                "const": "javascript-function-v1"
              }
            }
          },
          "then": {
            "required": [
              "function"
            ],
            "properties": {
              "language": {
                "const": "javascript"
              },
              "tests": {
                "minItems": 4,
                "maxItems": 20,
                "items": {
                  "$ref": "#/$defs/case"
                }
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "model_kind"
                  ]
                },
                {
                  "required": [
                    "output_format"
                  ]
                },
                {
                  "required": [
                    "uncertainty_model"
                  ]
                },
                {
                  "required": [
                    "assessment"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "evaluator": {
                "const": "python-stdio-v1"
              }
            }
          },
          "then": {
            "required": [
              "output_format"
            ],
            "properties": {
              "language": {
                "const": "python"
              },
              "tests": {
                "minItems": 4,
                "maxItems": 20,
                "items": {
                  "$ref": "#/$defs/stdio_case"
                }
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "function"
                  ]
                },
                {
                  "required": [
                    "model_kind"
                  ]
                },
                {
                  "required": [
                    "uncertainty_model"
                  ]
                },
                {
                  "required": [
                    "assessment"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "evaluator": {
                "const": "python-ml-linear-v1"
              }
            }
          },
          "then": {
            "required": [
              "function",
              "model_kind"
            ],
            "properties": {
              "language": {
                "const": "python"
              },
              "tests": {
                "minItems": 2,
                "maxItems": 8,
                "items": {
                  "$ref": "#/$defs/ml_case"
                }
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "output_format"
                  ]
                },
                {
                  "required": [
                    "uncertainty_model"
                  ]
                },
                {
                  "required": [
                    "assessment"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "evaluator": {
                "const": "python-weighted-fit-v1"
              }
            }
          },
          "then": {
            "required": [
              "function",
              "uncertainty_model"
            ],
            "properties": {
              "language": {
                "const": "python"
              },
              "tests": {
                "minItems": 2,
                "maxItems": 8,
                "items": {
                  "$ref": "#/$defs/scientific_case"
                }
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "model_kind"
                  ]
                },
                {
                  "required": [
                    "output_format"
                  ]
                },
                {
                  "required": [
                    "assessment"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "evaluator": {
                "const": "python-agent-tools-v1"
              }
            }
          },
          "then": {
            "required": [
              "function",
              "assessment"
            ],
            "properties": {
              "language": {
                "const": "python"
              },
              "function": {
                "const": "act"
              },
              "tests": {
                "minItems": 2,
                "maxItems": 8,
                "items": {
                  "$ref": "#/$defs/agent_case"
                }
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "model_kind"
                  ]
                },
                {
                  "required": [
                    "uncertainty_model"
                  ]
                },
                {
                  "required": [
                    "output_format"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "evaluator": {
                "const": "python-object-api-v1"
              }
            }
          },
          "then": {
            "required": [
              "interface"
            ],
            "properties": {
              "language": {
                "const": "python"
              },
              "comparison": {
                "const": {
                  "kind": "exact",
                  "absolute": 0,
                  "relative": 0
                }
              },
              "tests": {
                "minItems": 4,
                "maxItems": 20,
                "items": {
                  "$ref": "#/$defs/api_case"
                }
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "function"
                  ]
                },
                {
                  "required": [
                    "output_format"
                  ]
                },
                {
                  "required": [
                    "model_kind"
                  ]
                },
                {
                  "required": [
                    "uncertainty_model"
                  ]
                },
                {
                  "required": [
                    "assessment"
                  ]
                }
              ]
            }
          },
          "else": {
            "not": {
              "required": [
                "interface"
              ]
            }
          }
        }
      ]
    },
    "stdio_case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "stdin",
        "expected",
        "public"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "stdin": {
          "type": "string",
          "maxLength": 100000
        },
        "expected": {},
        "public": {
          "type": "boolean"
        }
      }
    },
    "dataset_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revision",
        "seed",
        "digest"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "digest": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "ml_split": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "features",
        "targets"
      ],
      "properties": {
        "features": {
          "type": "array",
          "minItems": 4,
          "maxItems": 128,
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "number",
              "minimum": -1000000.0,
              "maximum": 1000000.0
            }
          }
        },
        "targets": {
          "type": "array",
          "minItems": 4,
          "maxItems": 128,
          "items": {
            "type": "number",
            "minimum": -1000000.0,
            "maximum": 1000000.0
          }
        }
      }
    },
    "ml_case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "public",
        "train",
        "holdout",
        "thresholds",
        "dataset"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "public": {
          "type": "boolean"
        },
        "train": {
          "$ref": "#/$defs/ml_split"
        },
        "holdout": {
          "$ref": "#/$defs/ml_split"
        },
        "thresholds": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mse",
            "mae"
          ],
          "properties": {
            "mse": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000000.0
            },
            "mae": {
              "type": "number",
              "minimum": 0,
              "maximum": 1000000000000.0
            }
          }
        },
        "dataset": {
          "$ref": "#/$defs/dataset_identity"
        }
      }
    },
    "scientific_case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "public",
        "observations",
        "dataset"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "public": {
          "type": "boolean"
        },
        "observations": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "x",
            "y",
            "sigma"
          ],
          "properties": {
            "x": {
              "type": "array",
              "minItems": 4,
              "maxItems": 64,
              "items": {
                "type": "number",
                "minimum": -10000.0,
                "maximum": 10000.0
              }
            },
            "y": {
              "type": "array",
              "minItems": 4,
              "maxItems": 64,
              "items": {
                "type": "number",
                "minimum": -10000.0,
                "maximum": 10000.0
              }
            },
            "sigma": {
              "type": "array",
              "minItems": 4,
              "maxItems": 64,
              "items": {
                "type": "number",
                "minimum": 0.01,
                "maximum": 100
              }
            }
          }
        },
        "dataset": {
          "$ref": "#/$defs/dataset_identity"
        }
      }
    },
    "agent_case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "public",
        "environment"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "public": {
          "type": "boolean"
        },
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "records"
          ],
          "properties": {
            "records": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "amount",
                  "approved"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_-]{1,32}$"
                  },
                  "amount": {
                    "type": "integer",
                    "minimum": -100000,
                    "maximum": 100000
                  },
                  "approved": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        }
      }
    },
    "api_case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "public",
        "operations",
        "expected"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "public": {
          "type": "boolean"
        },
        "operations": {
          "type": "array",
          "minItems": 2,
          "maxItems": 64,
          "items": {
            "type": "object"
          }
        },
        "expected": {
          "type": "array",
          "minItems": 2,
          "maxItems": 64,
          "items": {
            "type": "object"
          }
        }
      }
    }
  }
}
