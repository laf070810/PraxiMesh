{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://praximesh.invalid/schema/content-v1.json",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "nodes", "problems"],
  "properties": {
    "schema_version": {"const": 1},
    "nodes": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/node"}},
    "problems": {"type": "array", "maxItems": 10000, "items": {"$ref": "#/$defs/problem"}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,79}$"},
    "text": {"type": "string", "minLength": 1, "maxLength": 20000},
    "ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "node": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "title", "summary", "body", "domains", "topics", "concepts", "outcomes", "aliases", "relations", "steps", "license", "attribution"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "kind": {"enum": ["domain", "topic", "concept", "tutorial", "path"]},
        "title": {"type": "string", "minLength": 1, "maxLength": 200},
        "summary": {"$ref": "#/$defs/text"}, "body": {"type": "string", "maxLength": 40000},
        "domains": {"$ref": "#/$defs/ids"}, "topics": {"$ref": "#/$defs/ids"}, "concepts": {"$ref": "#/$defs/ids"},
        "aliases": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 120}},
        "outcomes": {"type": "array", "items": {"$ref": "#/$defs/text"}},
        "relations": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["kind", "target"], "properties": {"kind": {"enum": ["required", "recommended", "related"]}, "target": {"$ref": "#/$defs/id"}}}},
        "steps": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["kind", "target"], "properties": {"kind": {"enum": ["tutorial", "problem"]}, "target": {"$ref": "#/$defs/id"}}}},
        "license": {"$ref": "#/$defs/text"}, "attribution": {"$ref": "#/$defs/text"}
      }
    },
    "case": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "args", "expected", "public"],
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 100},
        "args": {"type": "array", "maxItems": 8}, "expected": {}, "public": {"type": "boolean"}
      }
    },
    "problem": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "revision", "title", "summary", "statement", "constraints", "outcomes", "concepts", "difficulty", "language", "evaluator", "function", "starter", "reference", "hints", "tests", "comparison", "changelog", "license", "attribution", "tags"],
      "properties": {
        "id": {"$ref": "#/$defs/id"}, "revision": {"type": "integer", "minimum": 1},
        "title": {"type": "string", "minLength": 1, "maxLength": 200},
        "summary": {"$ref": "#/$defs/text"}, "statement": {"$ref": "#/$defs/text"}, "constraints": {"$ref": "#/$defs/text"},
        "outcomes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}},
        "concepts": {"allOf": [{"$ref": "#/$defs/ids"}], "minItems": 1},
        "difficulty": {"enum": ["入门", "基础", "进阶"]}, "language": {"const": "python"},
        "evaluator": {"const": "python-function-v1"},
        "function": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,60}$"},
        "starter": {"$ref": "#/$defs/text"}, "reference": {"$ref": "#/$defs/text"},
        "hints": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/text"}},
        "tests": {"type": "array", "minItems": 4, "maxItems": 20, "items": {"$ref": "#/$defs/case"}},
        "comparison": {"type": "object", "additionalProperties": false, "required": ["kind", "absolute", "relative"], "properties": {"kind": {"enum": ["exact", "numeric"]}, "absolute": {"type": "number", "minimum": 0, "maximum": 0.001}, "relative": {"type": "number", "minimum": 0, "maximum": 0.001}}},
        "tags": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 60}},
        "changelog": {"$ref": "#/$defs/text"}, "license": {"$ref": "#/$defs/text"}, "attribution": {"$ref": "#/$defs/text"}
      }
    }
  }
}
